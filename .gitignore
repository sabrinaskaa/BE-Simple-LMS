# =============================================================================
# Simple LMS - .gitignore
# =============================================================================

# --- Environment Variables (WAJIB tidak di-commit) ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# --- Coverage & Testing ---
.coverage
.tox/
.pytest_cache/
htmlcov/
coverage.xml
*.cover

# --- Virtual Environment ---
venv/
env/
.venv/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Celery ---
celerybeat-schedule
celerybeat.pid

# --- Docker ---
*.pid
